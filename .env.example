# Optional. Leave empty to keep the enquiry form in prototype mode
# (it validates input but sends nothing and says so).
#
# Set this to an HTTPS endpoint that accepts a JSON POST, for example a
# Formspree form endpoint or your own API route / CRM webhook.
# The form treats any 2xx response as success and anything else as an error.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Optional. The public URL of the deployed site, used for canonical links
# and social previews. Example: https://www.vishaks.com
NEXT_PUBLIC_SITE_URL=
